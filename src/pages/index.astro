---
/**
 * The homepage.
 *
 * CCS asked for a homepage that introduces Liberty Lighthouse and leads with
 * its topics, instead of opening straight onto the question index (which now
 * lives at /questions/). Three directions are under review at /preview/; this
 * renders whichever one DEFAULT_DIRECTION names, exactly as it would ship.
 */
import ReadingRoom from '../components/directions/reading-room/ReadingRoom.astro';
import SectorLight from '../components/directions/sector-light/SectorLight.astro';
import QuestionDeck from '../components/directions/question-deck/QuestionDeck.astro';
import { DEFAULT_DIRECTION } from '../components/directions/directions';
---

{DEFAULT_DIRECTION === 'reading-room' && <ReadingRoom />}
{DEFAULT_DIRECTION === 'sector-light' && <SectorLight />}
{DEFAULT_DIRECTION === 'question-deck' && <QuestionDeck />}
