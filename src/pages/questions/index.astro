---
/**
 * Every published question, grouped by topic: the page that used to be the
 * homepage.
 *
 * CCS asked for the homepage to introduce Liberty Lighthouse rather than open
 * straight onto the index, and for the index itself to stay one obvious click
 * away ("See all questions"). So the index moved here intact — the contents
 * census, the theme rail and every theme section — and the homepage became an
 * introduction that points at it.
 *
 * The featured three that led the old homepage did not come with it. They
 * were the front page's job, and above an index they only delay the list a
 * visitor came here to scan.
 *
 * Ships zero JavaScript of its own beyond the theme rail's scroll marker.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/global/Navbar.astro';
import Footer from '../../components/global/Footer.astro';
import IndexHead from '../../components/home/IndexHead.astro';
import Contents from '../../components/home/Contents.astro';
import ThemeRail from '../../components/home/ThemeRail.astro';
import ThemeSection from '../../components/home/ThemeSection.astro';
import { getCorpus } from '../../lib/corpus';
import { shareImageFor } from '../../lib/share-image';
import '../../styles/home.css';

const corpus = await getCorpus();

const description = `All ${corpus.totalQuestions} questions about Indian policy on Liberty Lighthouse, grouped by ${corpus.totalThemes} topics, with videos and syllabuses. A project of the Centre for Civil Society.`;
---

<BaseLayout title="All questions" description={description} ogImage={await shareImageFor('home')}>
  <Navbar />
  <main
    id="main-content"
    class="home"
    style={`--home-rows:${corpus.themes.length + 2}`}
  >
    <IndexHead corpus={corpus} />
    <Contents corpus={corpus} />
    <ThemeRail corpus={corpus} />
    {corpus.themes.map((theme) => <ThemeSection theme={theme} />)}
  </main>
  <Footer />
</BaseLayout>
