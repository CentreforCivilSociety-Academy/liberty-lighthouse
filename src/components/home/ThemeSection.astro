---
/**
 * One theme: its head, its ledger, and every one of its questions.
 *
 * Nothing here is truncated and there is no ellipsis anywhere. The section
 * shows the corpus rather than a description of it, which is the whole
 * argument of the page.
 */
import type { CorpusTheme } from '../../lib/corpus';

interface Props {
  theme: CorpusTheme;
}

const { theme } = Astro.props;

/*
 * The ledger names only what exists. Because it is a list rather than a fixed
 * set of slots, a theme with no videos simply does not mention videos — it
 * does not render an empty third door. Seven of eleven themes have no video,
 * and under the old three-badge frame every one of them read as broken.
 *
 * Each entry is a door now. It read as a label before, so the videos and the
 * syllabus were three clicks away through the theme page even though the page
 * had already told you they were there.
 */
const ledger = [
  {
    label: `${theme.questions} ${theme.questions === 1 ? 'question' : 'questions'}`,
    href: `/topics/${theme.slug}/faq/`,
  },
  theme.videos > 0
    ? {
        label: `${theme.videos} ${theme.videos === 1 ? 'video' : 'videos'}`,
        href: `/topics/${theme.slug}/videos/`,
      }
    : null,
  theme.hasSyllabus ? { label: 'syllabus', href: `/topics/${theme.slug}/syllabus/` } : null,
].filter(Boolean) as Array<{ label: string; href: string }>;

/** The same doors at the foot of the section, sized to be pressed. */
const doors = ledger.slice(1);
---

<section
  class="section"
  id={theme.anchor}
  style={`--theme-ink:${theme.ink}`}
  aria-labelledby={`${theme.anchor}-title`}
>
  <div class="section-head">
    <hr class="section-rule" />
    <p class="section-label" style={`color:${theme.ink}`}>
      {theme.section} &middot; <a href={theme.href} style={`color:${theme.ink}`}>All {theme.title}</a>
    </p>
    <h2 class="section-title" id={`${theme.anchor}-title`}>{theme.title}</h2>
    <p class="ledger">
      {ledger.map((item, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> · </span>}
          <a class="ledger-link" href={item.href} aria-label={`${item.label} in ${theme.title}`}>
            {item.label}
          </a>
        </>
      ))}
    </p>
    <p class="section-desc">{theme.description}</p>
  </div>

  <ol class="index">
    {theme.rows.map((row) => (
      <li class="index-row">
        <a class="index-link" href={row.href}>
          <span class="index-folio">{row.folio}</span>
          <span class="index-question">{row.question}</span>
        </a>

        {/*
          Secondary facts about the row, on the question's own left edge and in
          the same voice as everything else at this size. The word count sat in
          the margin gutter before, right-aligned against nothing, which gave
          the page a third vertical axis and read as something bolted on.
        */}
        <p class="index-meta">
          <span>{row.words.toLocaleString('en-IN')} words</span>
          {row.parts.length > 0 && (
            <>
              <span aria-hidden="true"> · </span>
              <span>
                Parts{' '}
                {row.parts.map((part, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={part.href}>{part.label}</a>
                  </>
                ))}
              </span>
            </>
          )}
        </p>
      </li>
    ))}
  </ol>

  <!--
    Every section ends with its own doors. This was one link to the theme page,
    which meant reaching a video took three clicks from a homepage that had
    already named it. The videos and the syllabus are destinations in their own
    right, so they get their own targets rather than a shared one.

    A plain div, not a nav: eleven sections would put eleven more landmarks in
    a screen reader's list. The labels carry the theme instead, so "6 videos"
    still says which theme it belongs to when read out of context.
  -->
  <div class="section-foot">
    <a class="section-go section-go-lead" href={theme.href}>All {theme.title}</a>
    {doors.map((door) => (
      <a class="section-go" href={door.href} aria-label={`${door.label} in ${theme.title}`}>
        {door.label}
      </a>
    ))}
  </div>
</section>
