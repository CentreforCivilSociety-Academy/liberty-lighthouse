---
/**
 * The index head: what the corpus is, and the way into it.
 *
 * It opens /questions/. On the old homepage it sat below three featured
 * questions; the featured questions stayed with the homepage when the index
 * moved, so this is the first thing on the page now.
 *
 * The count is read from the corpus, never written down: publish question 135
 * and this says 135 on the next build. The site's old byline promised
 * "10 themes" as a literal string, which is the bug this rule exists to stop.
 *
 * The h1 carries .hero-title because the CMS injects an unlayered
 * `h1:not(.hero-title)` font-size rule that no class or utility can outrank.
 */
import type { Corpus } from '../../lib/corpus';

interface Props {
  corpus: Corpus;
}

const { corpus } = Astro.props;
---

<header class="index-head">
  <h1 class="hero-title">
    {corpus.totalQuestions} questions about how India is actually governed
  </h1>

  <!--
    The client's byline (item 3), with the theme count derived rather than
    written. Their copy hardcoded "10 themes"; there are 11 as of this week,
    so their literal sentence would already have been wrong on the page. That
    is the failure this rule exists to prevent.
  -->
  <p class="byline">
    A resource to understand Indian policy across {corpus.totalThemes} themes,
    through FAQs, videos and syllabuses.
  </p>

  <form class="search" action="/search/" method="get" role="search">
    <label class="sr-only" for="q">Search questions</label>
    <input
      type="search"
      id="q"
      name="q"
      placeholder="Search questions"
      autocomplete="off"
    />
    <button type="submit">Search</button>
  </form>
</header>
