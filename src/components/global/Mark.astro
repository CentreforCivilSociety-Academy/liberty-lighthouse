---
/**
 * The Liberty Lighthouse mark.
 *
 * A lit square throwing eight beams. It reads as a bulb, as a lighthouse seen
 * from directly above, and as a silicon die with its leads — the last being
 * useful on a site that publishes an MCP endpoint.
 *
 * Everything is currentColor, so it takes the ink on paper and the paper
 * colour on the dark colophon. The mark it replaces carried five hardcoded
 * hexes, two of them the old brand browns, inside a filled badge.
 */

interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect x="9.5" y="9.5" width="5" height="5" fill="currentColor" />
  <g
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
  >
    <path d="M12 5.5V2M12 18.5V22M5.5 12H2M18.5 12H22" />
    <path d="M7.4 7.4L4.9 4.9M16.6 16.6L19.1 19.1M16.6 7.4L19.1 4.9M7.4 16.6L4.9 19.1" />
  </g>
</svg>
