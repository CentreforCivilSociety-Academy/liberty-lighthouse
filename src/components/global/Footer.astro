---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[var(--color-bg-dark)] text-[var(--color-text-on-dark)]" role="contentinfo">
  <div class="max-w-[var(--content-max-width)] mx-auto px-[var(--spacing-lg)] py-[var(--spacing-2xl)]">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-[var(--spacing-2xl)]">

      <!-- Brand -->
      <div>
        <p class="text-[1.125rem] font-[600] mb-[var(--spacing-sm)]" style="font-family: var(--font-display);">
          Liberty Lighthouse
        </p>
        <p class="text-[0.875rem] text-[var(--color-text-on-dark)] opacity-70 leading-relaxed max-w-[20rem]">
          A resource for understanding Indian policy through FAQs, videos and syllabuses. A project of the Centre for Civil Society.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <p class="text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-[var(--color-text-on-dark)] opacity-50 mb-[var(--spacing-md)]">
          Navigate
        </p>
        <nav aria-label="Footer navigation">
          <ul class="space-y-[var(--spacing-sm)] list-none p-0">
            <li><a href="/" class="text-[0.875rem] text-[var(--color-text-on-dark)] opacity-80 hover:opacity-100 no-underline transition-opacity duration-[var(--duration-fast)]">Topics</a></li>
            <li><a href="/glossary/" class="text-[0.875rem] text-[var(--color-text-on-dark)] opacity-80 hover:opacity-100 no-underline transition-opacity duration-[var(--duration-fast)]">Glossary</a></li>
            <li><a href="/about/" class="text-[0.875rem] text-[var(--color-text-on-dark)] opacity-80 hover:opacity-100 no-underline transition-opacity duration-[var(--duration-fast)]">About</a></li>
            <li><a href="/search/" class="text-[0.875rem] text-[var(--color-text-on-dark)] opacity-80 hover:opacity-100 no-underline transition-opacity duration-[var(--duration-fast)]">Search</a></li>
            <li><a href="/privacy/" class="text-[0.875rem] text-[var(--color-text-on-dark)] opacity-80 hover:opacity-100 no-underline transition-opacity duration-[var(--duration-fast)]">Privacy</a></li>
          </ul>
        </nav>
      </div>

      <!-- CCS -->
      <div>
        <p class="text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-[var(--color-text-on-dark)] opacity-50 mb-[var(--spacing-md)]">
          Centre for Civil Society
        </p>
        <ul class="space-y-[var(--spacing-sm)] list-none p-0">
          <li><a href="https://ccs.in" class="text-[0.875rem] text-[var(--color-text-on-dark)] opacity-80 hover:opacity-100 no-underline transition-opacity duration-[var(--duration-fast)]" target="_blank" rel="noopener noreferrer">ccs.in</a></li>
        </ul>
      </div>

    </div>

    <!--
      Publisher and funder. The Atlas mark is inline so its wordmark inherits
      the footer's ink; it carries one green accent of its own. CCS ships as a
      PNG because that is the only form available — worth replacing with an
      official vector when CCS supplies one.
    -->
    <div class="mt-[var(--spacing-2xl)] pt-[var(--spacing-lg)] border-t border-[var(--color-text-on-dark)]/10">
      <!--
        On a light plate, not on the dark footer. The CCS wordmark is #333234,
        which measures 1.41:1 against the footer background and is effectively
        invisible; on paper it is 12.35:1. Partner marks have to render as
        their owners drew them.
      -->
      <div class="inline-flex flex-wrap items-center gap-[var(--spacing-xl)] bg-[var(--color-bg-page)] text-[var(--color-text-primary)] px-[var(--spacing-lg)] py-[var(--spacing-md)]">
        <div>
          <p class="text-[0.6875rem] uppercase tracking-[0.1em] text-[var(--color-text-secondary)] mb-[var(--spacing-sm)]">
            A project of
          </p>
          <a href="https://ccs.in" target="_blank" rel="noopener noreferrer" class="inline-block opacity-90 hover:opacity-100 transition-opacity duration-[var(--duration-fast)]">
            <img
              src="/images/logos/ccs.png"
              alt="Centre for Civil Society"
              width="470"
              height="212"
              loading="lazy"
              decoding="async"
              class="h-[2.25rem] w-auto"
            />
          </a>
        </div>

        <div>
          <p class="text-[0.6875rem] uppercase tracking-[0.1em] text-[var(--color-text-secondary)] mb-[var(--spacing-sm)]">
            Member of
          </p>
          <a href="https://www.atlasnetwork.org" target="_blank" rel="noopener noreferrer" class="inline-block opacity-90 hover:opacity-100 transition-opacity duration-[var(--duration-fast)]">
            <img
              src="/images/logos/atlas-network.svg"
              alt="Atlas Network"
              width="441"
              height="148"
              loading="lazy"
              decoding="async"
              class="h-[1.75rem] w-auto"
            />
          </a>
        </div>
      </div>
    </div>

    <!-- Divider + Copyright -->
    <div class="mt-[var(--spacing-2xl)] pt-[var(--spacing-lg)] border-t border-[var(--color-text-on-dark)]/10 flex flex-wrap items-center justify-between gap-[var(--spacing-md)]">
      <p class="text-[0.75rem] text-[var(--color-text-on-dark)] opacity-70">
        &copy; {currentYear} Centre for Civil Society. All rights reserved. Platform built and managed by <a href="https://thothica.com" class="underline text-[var(--color-accent)] hover:text-[var(--color-accent-soft)] transition-colors duration-[var(--duration-fast)]" target="_blank" rel="noopener noreferrer">Thothica</a>.
      </p>
      <button
        type="button"
        data-cookie-settings
        class="text-[0.75rem] text-[var(--color-text-on-dark)] opacity-70 hover:opacity-100 underline underline-offset-2 transition-opacity duration-[var(--duration-fast)] bg-transparent border-0 cursor-pointer p-0"
      >
        Cookie settings
      </button>
    </div>

  </div>
</footer>

<script>
  import { openCookieConsent } from './CookieConsent';
  document.querySelectorAll('[data-cookie-settings]').forEach((btn) => {
    btn.addEventListener('click', () => openCookieConsent());
  });
</script>
