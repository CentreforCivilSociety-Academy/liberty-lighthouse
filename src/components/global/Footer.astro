---
/**
 * The footer, treated as part of the site rather than as the place where the
 * page stops.
 *
 * The partner marks get their own full-width band on paper, above the dark
 * block. They were previously a small chip tucked inside the dark footer,
 * which read as a compliance checkbox — and they have to be on paper anyway,
 * since the CCS wordmark measures 1.41:1 against the dark ground.
 *
 * The corpus figures move here from the homepage colophon, which was a second
 * dark band sitting immediately above this one. Every figure is derived, so
 * this stays true as CCS publishes.
 */
import Mark from './Mark.astro';
import { getCorpus } from '../../lib/corpus';

const currentYear = new Date().getFullYear();
const corpus = await getCorpus();

const corpusFigures = [
  `${corpus.totalQuestions} questions`,
  `${corpus.totalThemes} themes`,
  corpus.totalVideos > 0 ? `${corpus.totalVideos} videos` : null,
  corpus.totalSyllabi > 0 ? `${corpus.totalSyllabi} syllabuses` : null,
].filter(Boolean) as string[];

const navigate = [
  { href: '/', label: 'Index' },
  { href: '/glossary/', label: 'Glossary' },
  { href: '/search/', label: 'Search' },
  { href: '/about/', label: 'About' },
];

const elsewhere = [
  { href: '/ai/', label: 'AI and MCP access', external: false },
  { href: '/privacy/', label: 'Privacy', external: false },
  { href: 'https://ccs.in', label: 'ccs.in', external: true },
];
---

<!--
  The publisher, on paper and at a size that reads as an association rather
  than a footnote. CCS ships as a PNG because that is the only form available;
  worth replacing when they supply an official vector.
-->
<aside class="partners" aria-label="Publisher">
  <div class="partners-inner">
    <div class="partner">
      <p class="partner-label">Published by</p>
      <a href="https://ccs.in" target="_blank" rel="noopener noreferrer">
        <img
          src="/images/logos/ccs.png"
          alt="Centre for Civil Society"
          width="470"
          height="212"
          loading="lazy"
          decoding="async"
          class="partner-ccs"
        />
      </a>
    </div>
  </div>
</aside>

<footer class="site-footer" role="contentinfo">
  <div class="site-footer-inner">

    <div class="footer-brand">
      <p class="footer-wordmark">
        <Mark size={22} />
        <span>Liberty Lighthouse</span>
      </p>
      <p class="footer-blurb">
        A resource for understanding Indian policy through FAQs, videos and
        syllabuses.
      </p>
    </div>

    <div class="footer-cols">
      <div>
        <p class="footer-col-label">The corpus</p>
        <ul class="footer-figures">
          {corpusFigures.map((figure) => <li>{figure}</li>)}
        </ul>
      </div>

      <nav aria-label="Footer navigation">
        <p class="footer-col-label">Navigate</p>
        <ul>
          {navigate.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <p class="footer-col-label">Elsewhere</p>
        <ul>
          {elsewhere.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-credits">
      <p class="footer-copyright">
        &copy; {currentYear} Centre for Civil Society. All rights reserved.
      </p>
      <p class="footer-built">
        Platform built and managed by
        <a href="https://thothica.com" target="_blank" rel="noopener noreferrer">Thothica</a>
      </p>
      <button type="button" data-cookie-settings class="footer-cookies">
        Cookie settings
      </button>
    </div>

  </div>
</footer>

<style>
  /* ── Partner band ── */

  .partners {
    background: var(--color-bg-page);
    border-top: 1px solid var(--color-border-default);
  }

  .partners-inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 2.5rem var(--spacing-lg);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 2rem 4rem;
  }

  .partner-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0 0 0.875rem;
  }

  .partner a {
    display: inline-block;
    text-decoration: none;
  }

  /* Sized to the mark's own proportions, not to a shared box. */
  .partner-ccs { height: 3.5rem; width: auto; display: block; }

  /* ── Footer ── */

  .site-footer {
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
  }

  .site-footer-inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 3rem var(--spacing-lg);
  }

  .footer-wordmark {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.012em;
    margin: 0 0 0.625rem;
  }

  .footer-blurb {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-on-dark);
    opacity: 0.72;
    max-width: 26rem;
    margin: 0;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  @media (min-width: 646px) {
    .footer-cols { grid-template-columns: repeat(3, 1fr); }
  }

  .footer-col-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-on-dark);
    opacity: 0.55;
    margin: 0 0 0.875rem;
  }

  .footer-cols ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .footer-cols a {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--color-text-on-dark);
    opacity: 0.85;
    text-decoration: none;
  }

  .footer-cols a:hover { opacity: 1; text-decoration: underline; }

  .footer-figures li {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-on-dark);
    opacity: 0.85;
  }

  .footer-credits {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 2rem;
  }

  .footer-copyright,
  .footer-built {
    font-family: var(--font-body);
    /* Readable, not a footnote. The credit sat at 0.75rem and 70% opacity. */
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
    color: var(--color-text-on-dark);
    opacity: 0.72;
  }

  .footer-built a {
    color: var(--color-text-on-dark);
    opacity: 1;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  .footer-built a:hover { text-decoration-thickness: 2px; }

  .footer-cookies {
    margin-left: auto;
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-on-dark);
    opacity: 0.72;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .footer-cookies:hover { opacity: 1; }
</style>

<script>
  import { openCookieConsent } from './CookieConsent';
  document.querySelectorAll('[data-cookie-settings]').forEach((btn) => {
    btn.addEventListener('click', () => openCookieConsent());
  });
</script>
