---
import Mark from './Mark.astro';
const currentPath = Astro.url.pathname;

interface Props {
  /**
   * Where "Topics" points. The homepage is the topic directory, so by default
   * it is the topic section there; a homepage under review passes "#topics"
   * so the link stays on the design being looked at.
   */
  topicsHref?: string;
}

const { topicsHref = '/#topics' } = Astro.props;

function isActive(path: string): boolean {
  if (path.includes('#')) return false;
  return currentPath.startsWith(path);
}

/*
 * "All questions" is a first-class destination now that the homepage is an
 * introduction rather than the index itself.
 */
const navLinks = [
  { href: topicsHref, label: 'Topics' },
  { href: '/questions/', label: 'All questions' },
  { href: '/glossary/', label: 'Glossary' },
  { href: '/about/', label: 'About' },
];
---

<header class="sticky top-0 z-50 bg-[var(--color-bg-page)] border-b border-[var(--color-border-subtle)]">
  <nav class="max-w-[var(--content-max-width)] mx-auto px-[var(--spacing-lg)] h-[var(--nav-height)] flex items-center justify-between" aria-label="Main navigation">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-[0.5rem] no-underline group text-[var(--color-text-primary)]">
      <Mark size={26} class="flex-shrink-0" />
      <span class="text-[1.1875rem] font-[600] tracking-[-0.012em]" style="font-family: var(--font-display);">
        Liberty Lighthouse
      </span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-[var(--spacing-xl)]">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-[0.9375rem] font-medium no-underline transition-colors duration-[var(--duration-fast)]',
            isActive(link.href)
              ? 'text-[var(--color-primary)]'
              : 'text-[var(--color-text-secondary)] hover:text-[var(--color-primary)]',
          ]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}

      <!-- Search Link -->
      <a
        href="/search/"
        class="text-[var(--color-text-secondary)] hover:text-[var(--color-primary)] transition-colors duration-[var(--duration-fast)] no-underline"
        aria-label="Search"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
      </a>
    </div>

  </nav>

</header>

